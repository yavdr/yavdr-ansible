{{ ansible_managed.format(file=template_path) | comment }}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    {% if nginx_ssl_cert_path is defined and nginx_ssl_key_path is defined %}
    # Globaler Redirect auf HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
    {% else %}
    # Fallback auf reines HTTP (deine alte Config)
    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://localhost:8000/;
        include proxy_params;
    }
    {% endif %}
}
{% if nginx_ssl_cert_path is defined and nginx_ssl_key_path is defined %}
server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;

        ssl_certificate {{ nginx_ssl_cert_path }};
        ssl_certificate_key {{ nginx_ssl_key_path }};

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;

        root /var/www/html;

        index index.html index.htm index.nginx-debian.html;

        server_name _;

        location /api/ {
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Prefix /api;

            # for FastAPI WebSockets
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            proxy_pass http://unix:/run/yavdr-backend/uvicorn.sock:/;
        }

        location /assets/ {
            expires max;
            add_header Cache-Control "public, must-revalidate, proxy-revalidate";
            try_files $uri =404;
        }


        location / {
            try_files $uri $uri/ /index.html
        }
}
{% endif %}