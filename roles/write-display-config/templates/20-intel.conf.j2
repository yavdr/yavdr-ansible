{{ ansible_managed | comment }}

{% set primary_output = xrandr['Screen 0:'][xorg_config.primary.connector] %}
{% if xorg_config.secondary is defined %}
  {% set secondary_output = xrandr['Screen 0:'][xorg_config.secondary.connector] %}
{% endif %}

{% setprimary_output_name= xorg.primary.connector|replace("-", "") %}
{% set intel_driver = intel_driver | default("intel") %}
{% if xorg.secondary is defined %}
  {% set secondary_output_name = xorg.secondary.connector|replace("-", "") %}
{% endif %}

Section "Device"
  Identifier  "Device0"
  Driver      "{{ intel_driver }}"
  Option      "TearFree" "true"
{% if selected_frontend is defined and selected_frontend  == "softhdvaapi" and intel_driver == "intel" %}
    Option      "DRI" "3"
{% endif %}
{% if xorg.secondary is defined %}
  Option      "ZaphodHeads" "{{ primary_output_name }}"
  Screen      0  
{% endif %}
EndSection

{% if xorg.secondary is defined %}
Section "Device"
  Identifier  "Device1"
  Driver      "{{ intel_driver }}"
  Option      "TearFree" "true"
{%if selected_frontend is defined and selected_frontend  == "softhdvaapi" and intel_driver == "intel" %}
    Option      "DRI" "3"
{% endif %}
  Option      "ZaphodHeads" "{{ secondary_output_name }}"
  Screen      1  
EndSection

Section "ServerLayout"
    Identifier     "Layout0"
    Screen      0  "Screen0" 0 0
    Screen      1  "Screen1" RightOf "Screen0"
EndSection
{% endif %}

Section "Screen"
  Identifier  "Screen0"
  Device      "Device0"
  Monitor     "{{primary_output_name}}"
  DefaultDepth  24
  SubSection "Display"
    Depth       24
{% if xorg.primary.mode %}
    Modes     "{{ xorg.primary.mode }}"
{% else %}
    Modes     "1920x1080_50" "1920x1080_60" "1920x1080_24"
{% endif %}
  EndSubSection
EndSection

{% if xorg.secondary is defined %}
Section "Screen"
  Identifier  "Screen1"
  Device      "Device1"
  Monitor     "{{ secondary_output_name }}"
  DefaultDepth  24
  SubSection "Display"
    Depth       24
{% if xorg.secondary.mode %}
    Modes     "{{ xorg.secondary.mode }}"
{% else %}
    Modes     "1920x1080_50" "1920x1080_60" "1920x1080_24"
{% endif %}
  EndSubSection
EndSection

{% endif %}
Section "Monitor"
  Identifier  "{{primary_output_name}}"
{% if xrandr["Screen 0:"][xorg.primary.connector].modelines %}
  {% for mode, modeline in xrandr["Screen 0:"][xorg.primary.connector].modelines.items() %}
  {{ modeline }}
  {% endfor %}
  {# {{ xrandr["Screen 0:"][xorg.primary.connector].modelines[xorg.primary.mode]|default("") }} #}
{% elif xorg.primary.modelines %}
{% for modeline in xorg.primary.modelines %}
  {{ modeline }}
{% endfor %}
{% else %}
  Modeline    "1920x1080_24"     74.230 1920 2560 2604 2752 1080 1084 1089 1125 +hsync +vsync
  Modeline    "1920x1080_50"    148.500 1920 2448 2492 2640 1080 1084 1089 1125 +hsync +vsync
  Modeline    "1920x1080_60"    148.500 1920 2008 2056 2200 1080 1084 1089 1125 +hsync +vsync
{% endif %}
EndSection

{% if xorg.secondary is defined %}
Section "Monitor"
  Identifier  "{{ secondary_output_name }}"
{% if xrandr["Screen 0:"][xorg.secondary.connector].modelines %}
  {% for mode, modeline in xrandr["Screen 0:"][xorg.secondary.connector].modelines.items() %}
  {{ modeline }}
  {% endfor %}
{% else %}
  Modeline    "1920x1080_24"     74.230 1920 2560 2604 2752 1080 1084 1089 1125 +hsync +vsync
  Modeline    "1920x1080_50"    148.500 1920 2448 2492 2640 1080 1084 1089 1125 +hsync +vsync
  Modeline    "1920x1080_60"    148.500 1920 2008 2056 2200 1080 1084 1089 1125 +hsync +vsync
{% endif %}
EndSection

{% endif %}
{% for connector, data in xrandr["Screen 0:"].items() | list if not (
    data.is_connected|bool or
    connector == xorg.primary.connector or
    (xorg.secondary is defined and connector == xorg.secondary.connector))
 %}
Section "Monitor"
  Identifier "{{ connector|replace("-","") }}"
  Option "Ignore" "true"
EndSection

{% endfor %}
