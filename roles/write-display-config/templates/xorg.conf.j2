{{ ansible_managed.format(file=template_path) | comment }}

{%- set outputs = ansible_facts.display_outputs.connectors -%}
{%- set primary_config = custom_display_config.primary -%}
{%- set primary_mode = primary_config.resolution + '_' + primary_config.refreshrate | string -%}
{%- set primary_connector = primary_config.connector -%}
{%- set primary = outputs[primary_connector] -%}
{%- set primary_output = primary.xrandr_name  -%}
{%- set primary_modelines = primary.all_modelines -%}

{%- set use_secondary = custom_display_config.secondary is not none -%}
{%- if use_secondary -%}
{%- set secondary_config = custom_display_config.secondary -%}
{%- set secondary_connector = secondary_config.connector -%}
{%- set secondary = outputs[secondary_connector] -%}
{%- set secondary_output = secondary.xrandr_name -%}
{%- set secondary_mode = custom_display_config.secondary.resolution + '_' + secondary_config.refreshrate | string -%}
{%- set secondary_modelines = secondary.all_modelines -%}
{%- endif %}


Section "ServerLayout"
    Identifier     "Layout0"
    Screen         0  "Screen0" 0 0
{% if use_secondary %}
    Screen         1  "Screen1" RightOf "Screen0"
{% endif %}
    #InputDevice    "Keyboard0" "CoreKeyboard"
    #InputDevice    "Mouse0" "CorePointer"
    Option         "Xinerama" "0"
EndSection

Section "InputClass"
    Identifier "exclude eventlircd devices"
    MatchTag   "eventlircd"
    Option     "Ignore"    "True"
EndSection

Section "Monitor"
    Identifier     "Monitor0"
    VendorName     "{{ primary.vendor }}"
    ModelName      "{{ primary.model }}"
    Option         "DPMS"
    Option         "ExactModeTimingsDVI" "True"
EndSection

Section "Device"
    Identifier     "Device0"
    Driver         "nvidia"
    VendorName     "NVIDIA Corporation"
    Option         "NoLogo"              "true"
{% if primary.bus_id is not none %}
    BoardName      "{{ primary.card_name }}"
    BusID          "{{ primary.bus_id }}"
{% else %}
    BoardName      "Unknown"
{% endif %}
{% if (ansible_facts.nvidia_force_dpi | default(0)) > 0  %}
    Option         "UseEdidDpi" "FALSE"
    Option         "DPI" "{{ ansible_facts.nvidia_force_dpi }} x {{ ansible_facts.nvidia_force_dpi }}"
{% endif %}
    Screen          0
    Option         "ConnectedMonitor" "{{ primary.xrandr_name }}{% if use_secondary %}, {{ secondary.xrandr_name }}{% endif %}"
    Option         "CustomEDID" "{{ primary.xrandr_name }}:/etc/X11/edid.{{ primary.xrandr_name }}.bin{% if use_secondary %};{{ secondary.xrandr_name }}:/etc/X11/edid.{{ secondary.xrandr_name }}.bin{% endif %}"
EndSection

Section "Screen"
    Identifier     "Screen0"
    Device         "Device0"
    Monitor        "Monitor0"
    DefaultDepth    24
    Option         "nvidiaXineramaInfoOrder" "{{ primary.xrandr_name }}"
    Option         "UseDisplayDevice" "{{ primary.xrandr_name }}"
    Option         "metamodes" "{{ primary.xrandr_name }}: {{ primary_mode }} +0+0 {ForceCompositionPipeline=Off, ForceFullCompositionPipeline=Off}"
    Option         "AllowIndirectGLXProtocol" "off"
    Option         "TripleBuffer" "on"
    Option         "SLI" "Off"
    Option         "MultiGPU" "Off"
    Option         "BaseMosaic" "off"
    SubSection     "Display"
        Depth       24
    EndSubSection
EndSection

{% if use_secondary %}
Section "Device"
    Identifier     "Device1"
    Driver         "nvidia"
    VendorName     "NVIDIA Corporation"
    Option  "NoLogo"              "true"
    BoardName      "{{ secondary.card_name or "Unknown" }}"
{% if secondary.bus_id is not none %}
    BusID          "{{ secondary.bus_id }}"
{% endif %}
{% if (ansible_facts.nvidia_force_dpi | default(0)) > 0  %}
    Option         "UseEdidDpi" "FALSE"
    Option         "DPI" "{{ ansible_facts.nvidia_force_dpi }} x {{ ansible_facts.nvidia_force_dpi }}"
{% endif %}
    Screen          1
EndSection

Section "Monitor"
    Identifier     "Monitor1"
    VendorName     "{{ secondary.vendor }}"
    ModelName      "{{ secondary.model }}"
EndSection

Section "Screen"
    Identifier     "Screen1"
    Device         "Device1"
    Monitor        "Monitor1"
    DefaultDepth    24
    Option         "nvidiaXineramaInfoOrder" "{{ secondary.xrandr_name }}"
    #Option         "ConnectedMonitor" "{{ secondary.xrandr_name }}"
    Option         "UseDisplayDevice" "{{ secondary.xrandr_name }}"
    #Option         "CustomEDID" "{{ secondary.xrandr_name }}:/etc/X11/edid.{{ secondary.xrandr_name }}.bin"
    Option         "metamodes" "{{ secondary.xrandr_name }}: {{ secondary_mode }} +0+0 {ForceCompositionPipeline=Off, ForceFullCompositionPipeline=Off}"
    Option         "AllowIndirectGLXProtocol" "off"
    Option         "TripleBuffer" "on"
    Option         "SLI" "Off"
    Option         "MultiGPU" "Off"
    Option         "BaseMosaic" "off"
    SubSection     "Display"
        Depth       24
    EndSubSection
EndSection
{% endif %}

Section "Extensions"
    Option         "Composite" "Disable"
EndSection
