{{ ansible_managed.format(file=template_path) | comment }}

enable_nfs: {{ lifeguard_enable_nfs }}
enable_samba: {{ lifeguard_enable_samba }}
enable_ssh: {{ lifeguard_enable_ssh }}

# ping hostnames or IP addresses (which are faster to lookup than hostnames)
# Caution: pinging hosts can be quite slow!
{% set hosts = {"hosts": lifeguard_hosts} %}{{ hosts | to_nice_yaml }}
# check for logged in users
{% set user = {"user": lifeguard_users} %}{{ user | to_nice_yaml }}
# check for running processes
{% set process_names = {"process_names": lifeguard_processes} %}
{{ process_names | to_nice_yaml }}
# check for established tcp connections for the given process name on the given port(s)
{{ {'tcp_connections': lifeguardng_tcp_connections} | to_nice_yaml(indent=2) }}
